generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  category      String
  style         String
  price         Int
  originalPrice Int
  rating        Decimal  @db.Decimal(2, 1)
  sales         Int      @default(0)
  image         String   @db.Text
  tags          Json
  description   String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([style])
  @@index([price])
  @@map("products")
}
